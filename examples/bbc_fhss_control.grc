- name: jam_bytes
  id: variable
  parameters:
    comment: ''
    value: '[(i * 167 + 13) % 256 for i in range(4096)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 832
    - 76
    rotation: 0
    state: enabled
- name: commands
  id: variable
  parameters:
    comment: Two hop commands, sent in turn.
    value: list(b'+20000'.ljust(MESSAGE_LENGTH, b'\x00')) + list(b'-20000'.ljust(MESSAGE_LENGTH, b'\x00'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 12
    rotation: 0
    state: enabled
