- name: epy_block_0
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: Decoded message -> hop command
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: "\"\"\"\nTurn a decoded BBC message into a frequency command.\n\nThe control channel\
      \ carries an ASCII offset in Hz, e.g. b\"+20000\". Each\nmessage that survives the jammer is republished\
      \ as a `freq` PMT, which\nFrequency Xlating FIR Filter accepts on its `freq` port.\n\"\"\"\nimport\
      \ pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    def __init__(self):\n      \
      \  gr.basic_block.__init__(self, name=\"BBC Frequency Command\",\n                             \
      \   in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern(\"decoded\"))\n\
      \        self.message_port_register_out(pmt.intern(\"freq\"))\n        self.set_msg_handler(pmt.intern(\"\
      decoded\"), self.handle)\n\n    def handle(self, msg):\n        payload = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \        text = payload.rstrip(b\"\\x00\").decode(\"ascii\", \"ignore\").strip()\n        try:\n\
      \            offset = float(text)\n        except ValueError:\n            return\n        self.message_port_pub(\n\
      \            pmt.intern(\"freq\"),\n            pmt.cons(pmt.intern(\"freq\"), pmt.from_double(offset)))\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1712
    - 264
    rotation: 0
    state: enabled
